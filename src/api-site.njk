---
pagination:
  data: sites.entries
  size: 1
  alias: entry
permalink: "/api/site/{{ entry.slug }}.json"
eleventyExcludeFromCollections: true
---
{#
  One small JSON document per site, so a widget can look up a single URL
  without downloading the whole report. The full report.json is megabytes; each
  of these is under a kilobyte.

  Keyed by the same slug as the site's page. A consumer needs only the site
  URL: the slug is derived from it with string operations alone, so the embed
  component finds this file without an index to download and without
  crypto.subtle — which means it also works on a page served over plain http.

  Stored history is still keyed by hash under results/, and a slug that
  collides falls back to one, so this filename is presentation and the hash
  remains the identity.
-#}
{% set lab = entry.latest.lab if entry.latest %}
{
  "url": {{ entry.url | dump | safe }},
  "name": {{ entry.displayUrl | dump | safe }},
  "page": {{ ("/site/" + entry.slug + "/") | dump | safe }},
  "measured": {{ "true" if entry.latest else "false" }},
  "updated": {{ (entry.latest.date if entry.latest else null) | dump | safe }},
  "stale": {{ "true" if entry.dataStale else "false" }},
  "rank": {{ entry.ranks.overall | dump | safe if entry.ranks.overall else "null" }},
  "group": {{ entry.groupName | dump | safe }}
  {%- if entry.latest -%}
  ,
  "total": {{ entry.lighthouseTotal }},
  "lighthouse": {
    "performance": {{ lab.scores.performance | dump | safe }},
    "accessibility": {{ lab.scores.accessibility | dump | safe }},
    "bestPractices": {{ lab.scores["best-practices"] | dump | safe }},
    "seo": {{ lab.scores.seo | dump | safe }}
  },
  "metrics": {
    "lcp": {{ lab.timings.lcp | dump | safe }},
    "cls": {{ lab.timings.cls | dump | safe }},
    "tbt": {{ lab.timings.tbt | dump | safe }},
    "weight": {{ lab.weight.total | dump | safe }},
    "requests": {{ lab.weight.requests | dump | safe }}
  },
  "axe": {{ entry.axeViolations | dump | safe if entry.axeViolations != null else "null" }},
  "cwv": {% if entry.cwv %}{
    "source": {{ entry.cwv.source | dump | safe }},
    "pass": {{ entry.cwv.pass | dump | safe }},
    "parts": [
      {%- for p in entry.cwv.parts -%}
      {"key": {{ p.key | dump | safe }}, "value": {{ p.value | dump | safe }}, "rating": {{ p.rating | dump | safe }}}{{ "," if not loop.last }}
      {%- endfor -%}
    ]
  }{% else %}null{% endif %},
  {#
    Detections only. A presumed mark comes from the listing a site is on rather
    than from the page, and this file is what was measured — so a site that
    emits no generator tag reports none here, rather than reporting the claim
    that put it on the list.
  #}
  "generator": {% if entry.generator %}{{ entry.generator.name | dump | safe }}{% else %}null{% endif %},
  "host": {% if entry.host %}{{ entry.host.name | dump | safe }}{% else %}null{% endif %}
  {%- endif %}
}
