<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ meta.title }}</title>
<meta name="description" content="{{ description or meta.description }}">
{% if buildAwesome.runMode == "build" %}
<style>{% include "../css/style.css" %}</style>
{% else %}
<link rel="stylesheet" href="/css/style.css">
{% endif %}
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='14'>⚡</text></svg>">
<script>
/* Applied before first paint so a light-mode reader never sees a dark flash.
   Dark is the default; only a stored choice of "light" changes anything. */
try { if (localStorage.getItem("speedlify-theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}
</script>
</head>
<body>

<header class="masthead">
	<div class="wrap">
		<h1 class="masthead-hed"><a href="/">{{ meta.title }}</a></h1>
		{#
			The tagline, and nothing else. How much of the corpus has data is a fact
			about the instance rather than about the page you are on, so it reads as
			a colophon — see the footer.
		#}
		<p class="masthead-subhed">
			{#
				Trailing full stop trimmed: the sentence continues into the clause
				below, where `<meta name="description">` above wants it whole.
			#}
			{{ meta.description | replace(r/\.$/, "") }}
			{%- if sites.coverage.measured %} — measured continuously.{% else %}.{% endif %}
		</p>
		<p class="masthead-subhed">
			<a href="/runs/">Measurement runs</a> · <a href="/embed/">Embed a score</a>
			<!-- Hidden until scripted: without JS the choice cannot be stored,
			     and a button that silently does nothing is worse than none. -->
			· <button class="theme-toggle" type="button" id="theme-toggle" hidden>
			{#
				Font Awesome, via the transform — these become <use> references
				against the same spritesheet the stack marks use, so the two glyphs
				cost one symbol each across the whole site rather than a hand-drawn
				path in every page's <head>-adjacent markup.

				Empty, deliberately: the transform turns element content into a
				<title>, and the button already has visible text beside the icon.
			#}
			<i class="fa-solid fa-sun theme-icon theme-icon-sun" width="14" height="14" aria-hidden="true"></i>
			<i class="fa-solid fa-moon theme-icon theme-icon-moon" width="14" height="14" aria-hidden="true"></i>
			<span class="theme-toggle-text">Light mode</span>
		</button>
		</p>
	</div>
</header>

<main class="wrap">
	{{ content | safe }}
</main>

<footer class="footer">
	<div class="wrap">
		{#
			Build stamp and coverage in one line. Coverage moved down from the
			masthead: it is a status line about this instance, which belongs with
			the stamp and the source link rather than above every page's content.
		#}
		<p>
			Built <time datetime="{{ sites.generated }}">{{ sites.generated | date("long") }}</time>{% if meta.repo %} ·
			<a href="{{ meta.repo }}">Source on GitHub</a>{% endif %}
			{%- if sites.coverage.measured %} ·
			<strong>{{ sites.coverage.measured }}/{{ sites.coverage.total }}</strong>
			{{ sites.coverage.measured | plural("site") }} {{ sites.coverage.measured | verb("has", "have") }} data
			{#- The running total, which used to head its own line above. It is a
			    fact about the same set of sites, so it reads as a gloss on the
			    coverage fraction rather than as a separate statistic. #}
			{%- if sites.stats.totalMeasurements %} ({{ sites.stats.totalMeasurements | num }} {{ sites.stats.totalMeasurements | plural("measurement") }}){% endif %}
			{%- if sites.coverage.medianAgeHours %}, median age
			{% if sites.coverage.medianAgeHours < 48 %}{{ sites.coverage.medianAgeHours }}h{% else %}{{ (sites.coverage.medianAgeHours / 24) | round(1) }}d{% endif %}
			{%- endif %}.
			{% if sites.coverage.stale %}<span class="worse">{{ sites.coverage.stale }} stale</span> (over {{ sites.coverage.staleAfterHours }}h).{% endif %}
			{% if sites.coverage.never %}<span class="muted">{{ sites.coverage.never }} not yet measured.</span>{% endif %}
			{% if sites.stats.failing %}<span class="failing-note"><em>{{ sites.stats.failing | num }} currently failing.</em></span>{% endif %}
			{%- endif %}
		</p>
		<p class="muted">
			Lab data from Lighthouse{% if sites.hasFieldData %}, field data from the Chrome UX Report (28-day trailing p75){% endif %}.
			Lab numbers are simulated on one machine and will vary from real user data.
		</p>
	</div>
</footer>

<script>
/* The only scripted behaviour on the site. Everything else — including the
   sparklines and score rings — is rendered at build time. */
(function () {
	var root = document.documentElement;
	var button = document.getElementById("theme-toggle");
	if (!button) return;

	// Only the text node is rewritten: the icons are siblings of it, and
	// assigning to button.textContent would remove them.
	var text = button.querySelector(".theme-toggle-text") || button;

	function label() {
		var light = root.dataset.theme === "light";
		text.textContent = light ? "Dark mode" : "Light mode";
		button.setAttribute("aria-pressed", String(light));
	}

	button.hidden = false;
	label();

	button.addEventListener("click", function () {
		var light = root.dataset.theme !== "light";
		if (light) root.dataset.theme = "light";
		else delete root.dataset.theme;

		try { localStorage.setItem("speedlify-theme", light ? "light" : "dark"); } catch (e) {}
		label();
	});
})();
</script>

{#
	The Font Awesome spritesheet: one <symbol> for each mark this page actually
	uses, and nothing for the ones it does not. Last in the body because it is
	inert markup — the <use> references above resolve against it wherever it
	sits, and putting hundreds of path definitions ahead of the content would
	delay the content for no gain.

	Emitted unconditionally: the bundle is empty on a page with no icons, so
	there is nothing to branch on.
#}
{% getBundle "fontawesome" %}

</body>
</html>
