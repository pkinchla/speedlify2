---
layout: base.njk
permalink: /index.html
---

<section class="statbar">
	<div class="stat" title="Mean of the four-category total, which is what the leaderboard ranks by">
		<span class="stat-value">{{ sites.stats.avgTotal if sites.stats.avgTotal else "—" }}<span class="stat-suffix">/400</span></span>
		<span class="stat-label">Avg Lighthouse total</span>
	</div>
	<div class="stat" title="Sites scoring 100 in all four Lighthouse categories, with no axe violations and no Core Web Vital failing for real users">
		<span class="stat-value">{{ sites.stats.perfect }}<span class="stat-suffix">/{{ sites.stats.measured }}</span></span>
		<span class="stat-label">Perfect {{ sites.stats.perfect | plural("score") }}</span>
		{% if sites.stats.perfectEleventy %}
		<p class="stat-sub" title="{{ sites.stats.perfectEleventy }} of the {{ sites.stats.perfect }} perfect scores are built with Eleventy or Build Awesome, counting sites listed in the community repo that emit no generator tag">
			{{ sites.stats.perfectEleventy | num }}
			{% for mark in sites.stats.perfectEleventyMarks %}{% stackIcon mark %}{% endfor %}
			<span class="stat-sub-pct">({{ (sites.stats.perfectEleventy / sites.stats.perfect * 100) | round }}%)</span>
		</p>
		{% endif %}
	</div>
	<div class="stat">
		<span class="stat-value">{{ sites.stats.avgWeight | bytes }}</span>
		<span class="stat-label">Avg page weight</span>
		{#
			Absent until the report has enough days to be worth drawing — see
			MIN_WEIGHT_HISTORY_DAYS in lib/report.js.
		#}
		{% if sites.stats.weightHistory.length %}
		{% set weightTrend = { values: [] } %}
		{% for point in sites.stats.weightHistory %}
			{% set weightTrend = (weightTrend.values.push(point.avgWeight), weightTrend) %}
		{% endfor %}
		<span class="stat-spark" title="Daily average across every site measured that day, {{ sites.stats.weightHistory[0].date }} to {{ sites.stats.weightHistory[sites.stats.weightHistory.length - 1].date }}">
			{% sparkline weightTrend, { width: 150, height: 24 } %}
		</span>
		{% endif %}
	</div>
	{% if sites.cwvAvailable %}
	<div class="stat">
		<span class="stat-value">{{ sites.stats.cwvPassing }}<span class="stat-suffix">/{{ sites.stats.cwvAssessed }}</span></span>
		<span class="stat-label">Passing Core Web Vitals</span>
	</div>
	{% endif %}
</section>

{% if sites.coverage.measured %}
<p class="coverage">
	Measured continuously — each site refreshed on its own schedule, newest data shown.
	<strong>{{ sites.coverage.measured }}/{{ sites.coverage.total }}</strong>
	{{ sites.coverage.measured | plural("site") }} {{ sites.coverage.measured | verb("has", "have") }} data
	{%- if sites.coverage.medianAgeHours %}, median age
	{% if sites.coverage.medianAgeHours < 48 %}{{ sites.coverage.medianAgeHours }}h{% else %}{{ (sites.coverage.medianAgeHours / 24) | round(1) }}d{% endif %}
	{%- endif %}.
	{% if sites.coverage.stale %}<span class="worse">{{ sites.coverage.stale }} stale</span> (over {{ sites.coverage.staleAfterHours }}h).{% endif %}
	{% if sites.coverage.never %}<span class="muted">{{ sites.coverage.never }} not yet measured.</span>{% endif %}
	{% if sites.stats.failing %}<span class="failing-note">{{ sites.stats.failing | num }} currently failing.</span>{% endif %}
</p>
{% endif %}

{% if not sites.stats.measured %}
<div class="empty">
	<h2>No measurements yet</h2>
	<p>Run a measurement pass to populate this page:</p>
	<pre><code>npm run measure</code></pre>
	<p class="muted">
		Sites are configured in <code>config/sites.js</code>. For real-user Core Web
		Vitals — including INP, which Lighthouse cannot measure in a lab run — set
		<code>CRUX_API_KEY</code> and run <code>npx speedlify backfill</code> to seed
		six months of field history.
	</p>
</div>
{% endif %}

{% macro stacktally(tally, label, title) %}
{% if tally.items.length %}
<div class="tally">
	<h3 class="tally-head">
		{{ label }}
		<span class="tally-meta">{{ tally.distinct }} distinct · {{ tally.detected }} of {{ tally.detected + tally.unknown }} detected</span>
	</h3>
	<ul class="tally-list">
		{% for item in tally.items %}
		<li class="tally-item" title="{{ item.count }} {{ item.count | plural('site') }} {{ title }} {{ item.name }}">
			{% if item.icon %}{% stackIcon item %}{% endif %}
			<span class="tally-name">{{ item.name }}</span>
			<span class="tally-count">{{ item.count | num }}</span>
		</li>
		{% endfor %}
		{% if tally.rare %}
		{# One-offs with no brand mark, folded into a single row so the list stays
		   readable without the count silently disagreeing with the heading. #}
		<li class="tally-item tally-rare" title="{{ tally.rareNames | join(', ') }} — one site each">
			<span class="tally-name">…and {{ tally.rare }} one-off{{ tally.rare | plural('', 's') }}</span>
		</li>
		{% endif %}
	</ul>
</div>
{% endif %}
{% endmacro %}


{#
	A bar per major Eleventy version. Proportional widths rather than a chart
	library: five bars whose lengths are one number each do not need an axis, a
	legend, or JavaScript.

	Drawn from the sites that report a version, with the ones that do not stated
	underneath — most of the corpus emits no version at all, and bars that quietly
	represented two thirds of the sites they claim to would be the misleading kind
	of chart.
#}
{% macro versionbars(data) %}
{% if data.items.length %}
<div class="tally versions">
	<h3 class="tally-head">
		{# Marks and word in one element: the heading is a flex row with
		   space-between, and three children would push the icons away from the
		   word they belong to. The marks stand in for naming both projects, which
		   is the point — one count across a rename. #}
		<span class="version-title">
			{% for mark in data.marks %}{% stackIcon mark %}{% endfor %}
			Versions
		</span>
		<span class="tally-meta">{{ data.versioned | num }} of {{ data.total | num }} detected</span>
	</h3>
	<ul class="version-list">
		{% for item in data.items %}
		<li class="version-row" title="{{ item.count }} {{ item.count | plural('site') }} on Eleventy {{ item.label }}">
			<span class="version-label">{{ item.label }}</span>
			<span class="version-bar"><span class="version-fill" style="width: {{ (item.share * 100) | round(1) }}%"></span></span>
			<span class="version-count">{{ item.count | num }}</span>
			{# Its own column so the pills line up on their left edge rather than
			   drifting with the width of the count beside them. Of the sites that
			   reported a version — the same denominator the bars are drawn from,
			   not the total in the heading. #}
			<span class="version-share">{{ (item.share * 100) | round }}%</span>
		</li>
		{% endfor %}
		{% if data.unversioned %}
		{# The same shape the stack tally uses for its one-offs: a last row saying
		   what the rows above do not cover, so the bars and the heading's count
		   cannot appear to disagree. #}
		<li class="version-row version-rest" title="{{ data.unversioned | num }} {{ data.unversioned | plural('site') }} report the generator but no version">
			{# Whole phrase in the bar column, under the bars rather than under the
			   version labels: it is a note about the chart, not another version. #}
			<span></span>
			<span class="version-more">…and {{ data.unversioned | num }} more</span>
		</li>
		{% endif %}
	</ul>
</div>
{% endif %}
{% endmacro %}


{% if sites.groups.length > 1 or sites.moving.length or sites.orphans.length %}
<nav class="contents" aria-label="Categories">
	<span class="contents-label">Categories</span>
	<ul>
		{#
			Measured over listed, not just listed. Measurement is rolling — a
			category is added in one commit and fills in over the following days —
			so a bare total says how many URLs someone typed, while this says how
			much of the category the site can actually show you.
		#}
		{% for group in sites.groups %}
		{% if group.entries.length %}
		<li>
			<a href="/group/{{ group.id }}/">{{ group.name }}</a>
			<span class="contents-count" title="{{ group.measured | num }} of {{ group.entries.length | num }} measured at least once">
				{{ group.measured | num }}<span class="contents-of">/{{ group.entries.length | num }}</span>
			</span>
		</li>
		{% endif %}
		{% endfor %}
		{% if sites.moving.length %}
		<li>
			<a href="#moving">{{ sites.moving.length | plural("Site") }} that {{ sites.moving.length | verb("redirects", "redirect") }}</a>
			<span class="contents-count">{{ sites.moving.length }}</span>
		</li>
		{% endif %}
		{% if sites.orphans.length %}
		<li>
			<a href="#orphans">Orphaned {{ sites.orphans.length | plural("history", "histories") }}</a>
			<span class="contents-count">{{ sites.orphans.length }}</span>
		</li>
		{% endif %}
	</ul>
</nav>
{% endif %}

{#
	One ranked list across every category. The category pages carry the same
	table filtered and re-ranked within themselves; this is the overall view, so
	`ranks.overall` rather than `groupRanks`.
#}
{% set perfectTotal = metrics.SCORES.length * 100 %}
{#
	Both counts are computed before the section so the heading can state them.
	`shown` is every perfect site — not a truncation.

	`entry.perfect` rather than the rule spelled out here: it means full marks in
	every Lighthouse category and nothing amber or red beside them, and it is
	decided in lib/report.js so this table and the count in the stat tile above
	cannot drift apart. The exclusion beside it is the one thing the tile also
	applies — categories that opt out with `excludeFromPerfectScores`, currently
	the starters, whose near-empty demo pages would crowd out real sites.

	The Eleventy share of these is counted in the report instead — the stat tile
	that shows it renders above this, and `{% set %}` inside a loop does not
	survive the loop in Nunjucks.
#}
{% set shown = [] %}
{% for entry in sites.entries %}
	{% if entry.perfect and not entry.excludedFromPerfectScores %}{% set shown = (shown.push(entry), shown) %}{% endif %}
{% endfor %}
<section class="group" id="leaderboard">
	<div class="group-head">
		<h2>Perfect scores</h2>
		<p class="muted">
			{{ perfectTotal }} in all {{ metrics.SCORES.length }} Lighthouse categories, no axe
			violations, and no Core Web Vital failing real users. Sites CrUX has no data
			for still qualify; sites failing it do not. Every row here is tied on all of
			that, so the order comes down to the last tiebreaker: Speed Index per KB,
			plus TTFB and blocking time — a fast heavy site outranks a fast empty one.
		</p>
	</div>

	<div class="table-scroll">
	<table class="grid">
		<thead>
			<tr>
				<th class="col-rank">#</th>
				<th class="col-site">Site</th>
				<th class="col-stack" title="What built the site, detected from its generator tag or presumed from the list it is on">Tool</th>
				<th class="col-stack" title="Who serves the site, detected from its response headers on the same page load">Host</th>
				<th class="col-rings" title="The four Lighthouse categories, then the Core Web Vitals verdict from real users and violating nodes from a full axe run — the primary ranking and its two tiebreakers, in order">Scores</th>
				<th class="col-trend">Trend</th>
				<th>LCP</th>
				<th>CLS</th>
				<th>TBT</th>
				<th>Weight</th>
				<th>Req</th>
				{#
					Last, and only on this table. The board is drawn from every
					category at once, so "which list is this from?" is a question only
					here — the category pages already answer it in their heading.
				#}
				<th class="col-cats">Categories</th>
			</tr>
		</thead>
		<tbody>
		{#
			Not a truncation any more: this is every perfect site. The ceiling is
			derived from the score list rather than hardcoded to 400, so adding or
			removing a Lighthouse category cannot silently empty the table.
			`sites.entries` arrives already ranked, so filtering preserves that order.
		#}
		{% for entry in shown %}
			<tr{% if entry.currentlyFailing %} class="row-failing"{% endif %}>
				{#
					Position in this table, not the global rank. The board is a filtered
					view — perfect scores only, starters excluded — so the global rank
					skips every row that was filtered out, and a list of 130 rows ending
					at #158 reads as a bug rather than as a leaderboard.

					`shown` preserves the global ordering, so counting rows says the same
					thing about who beat whom while staying contiguous. The real rank is
					on hover, and the trophies follow it rather than the row number: an
					actual site's medal should not move because a starter above it was
					hidden.
				#}
				<td class="col-rank" title="{% if entry.ranks.overall %}#{{ entry.ranks.overall }} of {{ sites.stats.measured | num }} overall{% else %}unranked{% endif %}">
					<span class="trophy">{{ entry.ranks.overall | trophy }}</span><span class="hash">#</span>{{ loop.index }}
				</td>
				<td class="col-site">
					<a class="site-link" href="/site/{{ entry.slug }}/">
						{% set avatar = entry.url | avatar(meta.avatarService) %}
						{% if avatar %}<img class="favicon" src="{{ avatar }}" width="32" height="32" alt="" loading="lazy" decoding="async">{% endif %}
						<span title="{{ entry.displayUrl }}">{{ entry.displayUrl }}</span>
					</a>
					{% if entry.latest %}<span class="updated-tag {{ 'stale-age' if entry.dataStale }}" title="Measured {{ entry.latest.date | date('long') }}">{{ entry.latest.date | since }}</span>{% else %}<span class="updated-tag never">never</span>{% endif %}
					{% if entry.currentlyFailing %}<span class="badge badge-error" title="{{ entry.lastError }}">failing</span>{% endif %}
					{% if entry.redirectTo and entry.redirectTo != entry.url %}<span class="badge badge-redirect" title="Measured through a redirect to {{ entry.redirectTo }}{% if entry.redirectConfirmed %} — confirmed, so history will follow it{% else %} — {{ entry.redirectReason }}{% endif %}">&#8618; redirect</span>
					{% elif entry.canonicalUrl %}<span class="badge badge-redirect" title="Measured through a redirect to {{ entry.canonicalUrl }} — the site's canonical form of this URL">&#8618; redirect</span>{% endif %}
					{% if entry.unlisted %}<span class="badge badge-unlisted" title="Built with {{ entry.unlisted.generator }} but not in {{ entry.unlisted.groupName }} — nobody has submitted it to the 11ty/11ty-community repository">unlisted</span>{% endif %}
				</td>

				{% if entry.latest %}
					<td class="col-stack">
						{% if entry.generator %}{% stackIcon entry.generator %}
						{% elif entry.presumedGenerator %}{% stackIcon entry.presumedGenerator %}
						{% else %}<span class="stack-none" title="No generator detected">·</span>{% endif %}
					</td>
					<td class="col-stack">
						{% if entry.host %}{% stackIcon entry.host %}{% else %}<span class="stack-none" title="No host detected">·</span>{% endif %}
					</td>
					{#
						Six rings, in the order <speedlify-score> draws them: the four
						Lighthouse categories, then Core Web Vitals and axe — the ranking's
						two tiebreakers in the order it applies them, and the two things
						Lighthouse's own categories do not cover. One column rather than
						three, so a row reads as one picture and matches the embeddable
						badge exactly.

						No total on the end, unlike the category tables: every row in this
						one is on {{ perfectTotal }} by definition, so it would be the same
						number all the way down.
					#}
					<td class="col-rings">
						<span class="rings">
						{% for score in metrics.SCORES %}
							{% scoreRing entry.latest.lab.scores[score.key], score.label %}
						{% endfor %}
						{% cwvRing entry.cwvFailures, entry.cwv.assessed %}
						{% axeRing entry.axe %}
						</span>
					</td>
					<td class="col-trend">{% sparkline entry.trends.performance %}</td>
					<td class="num">{{ entry.latest.lab.timings.lcp | ms }}</td>
					<td class="num">{{ entry.latest.lab.timings.cls | unit("") }}</td>
					<td class="num">{{ entry.latest.lab.timings.tbt | ms }}</td>
					<td class="num">{{ entry.latest.lab.weight.total | bytes }}</td>
					<td class="num">{{ entry.latest.lab.weight.requests | num }}</td>
					<td class="col-cats">
						{% for name in entry.groupNames %}<span class="cat-chip">{{ name }}</span>{% endfor %}
					</td>
				{% else %}
					<td class="num muted" colspan="10">
						{% if entry.currentlyFailing %}every attempt failed{% else %}awaiting first measurement{% endif %}
					</td>
				{% endif %}
			</tr>
		{% endfor %}
		</tbody>
	</table>
	</div>

	<p class="see-all">
		{% if shown.length %}
		{{ shown.length | countOf("site") }} of {{ sites.stats.measured | num }} measured
		{{ shown.length | verb("is", "are") }} {{ shown.length | verb("a perfect score", "perfect scores") }}.
		The full lists are on the category pages.
		{% else %}
		No site is a perfect score yet. The full lists are on the category pages.
		{% endif %}
	</p>
</section>

{% if sites.stacks.generators.items.length or sites.stacks.hosts.items.length %}
<section class="stacks">
	{{ stacktally(sites.stacks.generators, "Built with", "built with") }}
	{{ versionbars(sites.stacks.eleventyVersions) }}
	{{ stacktally(sites.stacks.hosts, "Hosted by", "hosted by") }}
</section>
{% endif %}


{% if sites.moving.length %}
<section class="redirects" id="moving">
	<h2>{{ sites.moving.length | plural("Site") }} that {{ sites.moving.length | verb("redirects", "redirect") }}</h2>
	<p class="muted">
		Lighthouse follows a redirect, so these are already measured at their
		destination — the numbers are real, they just describe the page the URL
		leads to. What is pending is whether the move is permanent enough to move
		the <em>history</em> too, which happens on its own once a redirect proves
		stable. Nothing here needs a config change.
	</p>

	{#
		Grouped by verdict rather than listed flat. A hundred rows each stamped
		with the same machine-readable reason tells you nothing; the reason is
		the interesting part, so it becomes the heading and is said once.
	#}
	{% set reasons = [] %}
	{% for move in sites.moving %}
		{% set key = "confirmed" if move.confirmed else (move.reason or "unknown") %}
		{% if key not in reasons %}{% set reasons = (reasons.push(key), reasons) %}{% endif %}
	{% endfor %}

	{% for reason in reasons %}
	{% set group = [] %}
	{% for move in sites.moving %}
		{% if ("confirmed" if move.confirmed else (move.reason or "unknown")) == reason %}
			{% set group = (group.push(move), group) %}
		{% endif %}
	{% endfor %}

	<h3 class="redirects-head">
		{% if reason == "confirmed" %}Confirmed — history follows{% else %}{{ reason | redirectReason }}{% endif %}
		<span class="redirects-count">{{ group.length | num }}</span>
	</h3>
	<p class="muted small">
		{% if reason == "confirmed" %}
		The destination has been consistent and permanent across several runs, so
		measurement has already followed it and the history came along.
		{% else %}{{ reason | redirectExplanation }}{% endif %}
	</p>
	{#
		The same scrolling grid the leaderboards use. Two full URLs per row is
		more than the column can hold on a narrow screen, and a table that
		scrolls inside its own box beats one that wraps every row to three lines
		or pushes the page sideways.
	#}
	<div class="table-scroll">
	<table class="grid compact">
		<thead>
			<tr>
				<th class="col-url">Redirect</th>
				<th class="col-url">Categories</th>
			</tr>
		</thead>
		<tbody>
			{% for move in group %}
			<tr>
				{#
					Both URLs in one cell. Split across two columns the arrow sat at the
					start of the second one, and the gap between columns grew to the
					width of the longest source URL on the page — so the pair read as
					two unrelated lists rather than as one redirect.
				#}
				<td class="col-url">
					<a href="/site/{{ move.slug }}/">{{ move.from }}</a>
					<span class="redirects-arrow">&rarr;</span>
					<code>{{ move.to }}</code>
				</td>
				{# `cat`, not `group` — the outer loop is already using that name. #}
				<td class="col-url">{% for cat in move.groups %}<span class="cat-chip">{{ cat }}</span>{% endfor %}</td>
			</tr>
			{% endfor %}
		</tbody>
	</table>
	</div>
	{% endfor %}
</section>
{% endif %}

{% if sites.orphans.length %}
<section class="orphans" id="orphans">
	<h2>Orphaned {{ sites.orphans.length | plural("history","histories") }}</h2>
	<p class="muted">
		These URLs have stored measurements but are no longer in
		<code>config/sites.js</code>. Their history is kept, not deleted.
	</p>
	<ul>
		{% for orphan in sites.orphans %}
		<li><code>{{ orphan.url or orphan.hash }}</code>{% if orphan.name %} — {{ orphan.name }}{% endif %}</li>
		{% endfor %}
	</ul>
</section>
{% endif %}

{% if sites.archived.length %}
{#
	Last on the page, and deliberately inert. Archiving is for a URL that should
	stop being pointed at — a site that has gone, or one that should not be sent
	traffic — so there is no row, no rank and no link, here or anywhere: an
	archived site has no page of its own either, since those are generated from
	the entries it was removed from.

	Still named, because the alternative is a silent disappearance. The record
	stays on disk; this is what says so.
#}
<section class="orphans" id="archived">
	<h2>Archived</h2>
	<p class="muted">
		{{ sites.archived.length | countOf("site") }} kept in the record but taken
		out of circulation: no longer measured, ranked or linked. Their stored
		measurements are still on disk.
	</p>
	<p class="muted small">
		This is for sites that have lapsed or whose domain is now parked — not for
		sites that have moved off Eleventy or Build Awesome. Those keep being
		measured and move to
		<a href="/group/11ty-emeritus/">11ty Emeritus</a>, which happens on its own
		the next time the generator comes back as something else.
	</p>
	<ul>
		{% for site in sites.archived %}
		<li><code>{{ site.displayUrl }}</code>{% if site.lastMeasured %} — last measured {{ site.lastMeasured | date("long") }}{% endif %}</li>
		{% endfor %}
	</ul>
</section>
{% endif %}
